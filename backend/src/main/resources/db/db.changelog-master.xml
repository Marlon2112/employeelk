<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Создание таблицы сотрудников -->
    <changeSet id="1" author="N.Halilov">
        <createTable tableName="employees">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="full_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <!-- Таблица зарплаты -->
    <changeSet id="2" author="N.Halilov">
        <createTable tableName="salaries">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC(10,2)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="salaries"
                                 baseColumnNames="employee_id"
                                 referencedTableName="employees"
                                 referencedColumnNames="id"
                                 constraintName="fk_salary_employee"/>
    </changeSet>

    <!-- Таблица рабочего времени -->
    <changeSet id="3" author="N.Halilov">
        <createTable tableName="working_times">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="extra_hours" type="INTEGER"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="working_times"
                                 baseColumnNames="employee_id"
                                 referencedTableName="employees"
                                 referencedColumnNames="id"
                                 constraintName="fk_workingtime_employee"/>
    </changeSet>

    <!-- Таблица отпусков -->
    <changeSet id="4" author="N.Halilov">
        <createTable tableName="vacations">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="vacations"
                                 baseColumnNames="employee_id"
                                 referencedTableName="employees"
                                 referencedColumnNames="id"
                                 constraintName="fk_vacation_employee"/>
    </changeSet>

    <!-- Таблица больничного -->
    <changeSet id="5" author="N.Halilov">
        <createTable tableName="sick_leaves">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
            <column name="document_info" type="VARCHAR(255)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="sick_leaves"
                                 baseColumnNames="employee_id"
                                 referencedTableName="employees"
                                 referencedColumnNames="id"
                                 constraintName="fk_sickleave_employee"/>
    </changeSet>
    <!-- Регистрация -->
    <changeSet id="6" author="N.Halilov">
        <createTable tableName="logins">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="login" type="VARCHAR(255)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="logins-add-role-and-mustchange" author="you">
        <addColumn tableName="logins">
            <column name="role" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="must_change_password" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Суперюзер -->
    <changeSet id="seed-admin" author="N.Halilov" context="seed">
        <insert tableName="logins">
            <column name="login" value="admin"/>
            <column name="password" value="$2a$10$UXbsdCBUMwuUMODfXeKGLOJKstGDeQPYvjIVgVhu/EchpAv7fbYF6"/>
            <column name="role" value="ADMIN"/>
            <column name="must_change_password" valueBoolean="true"/>
        </insert>
    </changeSet>

    <!-- Таблица ролей -->
    <changeSet id="7" author="N.Halilov">
        <createTable tableName="roles">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Таблица user_roles для связи многие-ко-многим между logins и roles -->
    <changeSet id="8" author="N.Halilov">
        <createTable tableName="user_roles">
            <column name="login_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="user_roles"
                                 baseColumnNames="login_id"
                                 referencedTableName="logins"
                                 referencedColumnNames="id"
                                 constraintName="fk_userroles_login"/>
        <addForeignKeyConstraint baseTableName="user_roles"
                                 baseColumnNames="role_id"
                                 referencedTableName="roles"
                                 referencedColumnNames="id"
                                 constraintName="fk_userroles_role"/>
        <addUniqueConstraint tableName="user_roles"
                            columnNames="login_id,role_id"
                            constraintName="uk_userroles_login_role"/>
    </changeSet>
    <changeSet id="9" author="your_name">
        <insert tableName="roles">
            <column name="name" value="EMPLOYEE"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="HR"/>
        </insert>
    </changeSet>
</databaseChangeLog>